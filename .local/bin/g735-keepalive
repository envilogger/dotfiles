#!/usr/bin/env bash
# Keep the Logitech G735 wireless adapter streaming so the headset does not
# power itself off after five minutes of silence.
#
# Measures the signal level on the headset sink's monitor and, for an hour
# after the last audible sound, feeds the sink inaudible pink noise (about
# -84 dBFS). After that the sink is left alone again, so the headset switches
# off as usual.
#
# The level meter replaces looking for playing sink-inputs: Chrome parks an
# uncorked stream on the sink forever, so every poll looked like playback and
# the hour never expired.
#
# Usage: g735-keepalive     runs in the foreground; meant for the systemd user unit
#
# Environment:
#   G735_SINK    substring matching the sink name  (default G735)
#   G735_HOLD    seconds to hold after playback    (default 3600)
#   G735_POLL    poll interval in seconds          (default 5)
#   G735_AMP     noise peak, 1.0 is full scale     (default 0.0001)
#   G735_LEVEL   playback threshold in dBFS        (default -60)
set -euo pipefail

sink_match=${G735_SINK:-G735}
hold=${G735_HOLD:-3600}
poll=${G735_POLL:-5}
amp=${G735_AMP:-0.0001}
level_db=${G735_LEVEL:--60}

node_name=g735-keepalive
meter_name=$node_name-meter
rate=48000
loop_secs=10
mon_rate=8000   # level meter capture rate, mono
mon_block=2000  # samples per peak window, 250 ms

runtime=${XDG_RUNTIME_DIR:-/tmp}
noise=$runtime/$node_name-$amp.raw
loud_file=$runtime/$node_name.loud  # its mtime is the last time the sink was loud

# Threshold as a 16-bit sample value. The default -60 dBFS sits far above the
# -84 dBFS keep-alive noise, so we never mistake our own feed for playback.
peak_min=$(awk -v d="$level_db" 'BEGIN { p = int(32767 * 10 ^ (d / 20)); print (p < 1 ? 1 : p) }')

# Reads the raw capture, takes the peak of each block and touches the marker
# file when a block is loud. A shell pipeline can do this too, but this costs
# about a fifteenth of the CPU, and the meter runs around the clock.
meter_prog='
import sys, array
thr, marker, samples = int(sys.argv[1]), sys.argv[2], int(sys.argv[3])
buf = sys.stdin.buffer
while True:
    block = buf.read(samples * 2)
    if not block:
        break
    peaks = array.array("h")
    peaks.frombytes(block[:len(block) // 2 * 2])
    if peaks and (max(peaks) >= thr or min(peaks) <= -thr):
        open(marker, "w").close()
'

feeder=       # process group of the running keep-alive pipeline
feed_since=0  # when it was started
meter=        # process group of the running level meter
meter_sink=   # sink the meter was started for
last_play=0   # epoch of the last audible sound on the sink

now() { printf '%(%s)T' -1; }

# One loopable buffer of inaudible noise, generated once per boot.
make_noise() {
    [[ -s $noise ]] && return
    ffmpeg -hide_banner -loglevel error -y \
        -f lavfi -i "anoisesrc=r=$rate:c=pink:a=$amp" -ac 2 -t "$loop_secs" \
        -f s16le "$noise.$$"
    mv "$noise.$$" "$noise"
}

# "<index> <name>" of the headset sink, empty when the adapter is unplugged.
sink_info() {
    pactl -f json list sinks 2>/dev/null |
        jq -r --arg m "$sink_match" \
            'first(.[] | select(.name | contains($m)) | "\(.index) \(.name)")' 2>/dev/null
}

# True when our own stream is attached to sink $1.
attached() {
    pactl -f json list sink-inputs 2>/dev/null |
        jq -e --argjson s "$1" --arg n "$node_name" \
            'any(.[]; .sink == $s and .properties["node.name"] == $n)' >/dev/null 2>&1
}

running() { [[ -n $1 ]] && kill -0 "$1" 2>/dev/null; }

stop_feed() {
    running "$feeder" && kill -TERM -- "-$feeder" 2>/dev/null || :
    feeder=
}

stop_meter() {
    running "$meter" && kill -TERM -- "-$meter" 2>/dev/null || :
    meter= meter_sink=
}

start_feed() {
    if running "$feeder"; then
        # Give it a moment to show up, then restart if it lost its sink.
        (( $(now) - feed_since < 15 )) && return 0
        attached "$1" && return 0
        stop_feed
    fi
    make_noise
    # setsid puts the pipeline in its own process group, so stop_feed gets both
    # the loop and pw-cat; killing pw-cat alone would leave cat writing.
    setsid bash -c '
        while :; do cat "$1"; done |
            exec pw-cat --playback --raw --format s16 --rate "$2" --channels 2 \
                --latency 200ms --target "$3" \
                -P node.name="$4" -P media.name=keep-alive -
    ' _ "$noise" "$rate" "$2" "$node_name" >/dev/null 2>&1 &
    feeder=$!
    feed_since=$(now)
}

# Record the sink monitor and mark the marker file whenever the signal is
# audible. stream.capture.sink taps the sink's own output, so this hears every
# stream mixed into it, ours included.
start_meter() {
    if running "$meter"; then
        [[ $meter_sink == "$1" ]] && return 0
        stop_meter
    fi
    rm -f "$loud_file"
    setsid bash -c '
        pw-cat --record --raw --format s16 --rate "$2" --channels 1 \
            --latency 100ms --target "$1" -P stream.capture.sink=true \
            -P node.name="$3" -P media.name=level-meter - |
            exec python3 -c "$7" "$4" "$5" "$6"
    ' _ "$1" "$mon_rate" "$meter_name" "$peak_min" "$loud_file" "$mon_block" \
        "$meter_prog" >/dev/null 2>&1 &
    meter=$!
    meter_sink=$1
}

trap 'stop_feed; stop_meter; exit 0' INT TERM
trap 'stop_feed; stop_meter' EXIT

while :; do
    idx= name=
    read -r idx name < <(sink_info) || :

    if [[ -n $idx ]]; then
        start_meter "$name"
        loud=$(stat -c %Y "$loud_file" 2>/dev/null || echo 0)
        (( loud > last_play )) && last_play=$loud
        if (( $(now) - last_play < hold )); then
            start_feed "$idx" "$name"
        else
            stop_feed
        fi
    else
        stop_feed
        stop_meter
    fi

    sleep "$poll"
done
